{
  "name": "htmx-framework-integrations",
  "version": "1.0.0",
  "description": "Seamless integration between HTMX and modern frontend frameworks",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "htmx",
    "react",
    "vue",
    "svelte",
    "websocket",
    "sse",
    "real-time"
  ],
  "author": "HTMX Contributors",
  "license": "MIT",
  "dependencies": {
    "htmx.org": "^1.9.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "vue": "^2.6.0 || ^3.2.0",
    "svelte": "^3.44.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/react": "^18.2.0",
    "@types/vue": "^2.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.57.0",
    "rollup": "^4.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
